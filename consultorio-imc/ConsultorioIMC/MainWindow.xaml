<Window x:Class="ConsultorioIMC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consultorio de Fisioterapia - Indice de Massa Corporal" Height="620" Width="760">
    <Grid>
        <Label Content="CONSULTORIO DE FISIOTERAPIA - PESQUISA DE IMC" FontSize="16" Margin="20,15,0,0"/>

        <Label Content="Id:" Margin="20,60,0,0"/>
        <TextBox x:Name="txtId" Width="80" Height="26" Margin="60,62,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Content="Consultar" Width="100" Height="26" Margin="150,62,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Consultar_Click"/>

        <Label Content="Nome:" Margin="20,100,0,0"/>
        <TextBox x:Name="txtNome" Width="420" Height="26" Margin="80,102,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <Label Content="Peso (Kg):" Margin="20,140,0,0"/>
        <TextBox x:Name="txtPeso" Width="100" Height="26" Margin="100,142,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <Label Content="Altura (m):" Margin="240,140,0,0"/>
        <TextBox x:Name="txtAltura" Width="100" Height="26" Margin="320,142,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <Button Content="Cadastrar" Width="100" Height="30" Margin="20,185,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Cadastrar_Click"/>
        <Button Content="Alterar" Width="100" Height="30" Margin="130,185,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Alterar_Click"/>
        <Button Content="Excluir" Width="100" Height="30" Margin="240,185,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Excluir_Click"/>
        <Button Content="Limpar" Width="100" Height="30" Margin="350,185,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Limpar_Click"/>
        <Button Content="Relatorio HTML" Width="130" Height="30" Margin="460,185,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Relatorio_Click"/>

        <Label x:Name="lblResultado" Content="Informe os dados e clique em Cadastrar." Margin="20,230,0,0" FontSize="14"/>

        <Label Content="Peso das pessoas cadastradas:" Margin="20,265,0,0"/>
        <ListBox x:Name="lstPesos" Width="700" Height="250" Margin="20,295,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Consolas"/>
    </Grid>
</Window>
