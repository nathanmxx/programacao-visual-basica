<Window x:Class="CalculadoraHohmann.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculadora Interplanetária"
        Height="600"
        Width="700">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0"
               Grid.ColumnSpan="2"
               Content="Calculadora de Trajetória Interplanetária"
               FontSize="22"
               FontWeight="Bold"
               HorizontalContentAlignment="Center"/>

        <Label Grid.Row="1"
               Content="Distância da origem ao Sol (milhões de km):"/>

        <TextBox x:Name="txtOrigem"
                 Grid.Row="1"
                 Grid.Column="1"
                 Height="30"
                 AcceptsReturn="True"/>

        <Label Grid.Row="2"
               Content="Distância do destino ao Sol (milhões de km):"/>

        <TextBox x:Name="txtDestino"
                 Grid.Row="2"
                 Grid.Column="1"
                 Height="30"
                 AcceptsReturn="True"/>

        <Label Grid.Row="3"
               Content="Massa da nave (kg):"/>

        <TextBox x:Name="txtMassa"
                 Grid.Row="3"
                 Grid.Column="1"
                 Height="30"
                 AcceptsReturn="True"/>

        <Label Grid.Row="4"
               Content="Impulso do motor (s):"/>

        <TextBox x:Name="txtImpulso"
                 Grid.Row="4"
                 Grid.Column="1"
                 Height="30"
                 AcceptsReturn="True"/>

        <Button Grid.Row="5"
                Content="Calcular"
                Width="150"
                Height="40"
                Click="btnCalcular_Click"/>

        <Button Grid.Row="5"
                Grid.Column="1"
                Content="Limpar"
                Width="150"
                Height="40"
                Click="btnLimpar_Click"/>

        <Label Grid.Row="6"
               Grid.ColumnSpan="2"
               Content="RESULTADOS"
               FontSize="18"
               FontWeight="Bold"
               HorizontalContentAlignment="Center"/>

        <Label Grid.Row="7"
               Content="Tempo da viagem:"/>

        <Label x:Name="lblTempo"
               Grid.Row="7"
               Grid.Column="1"
               Content="-"/>

        <Label Grid.Row="8"
               Content="Delta-V:"/>

        <Label x:Name="lblDeltaV"
               Grid.Row="8"
               Grid.Column="1"
               Content="-"/>

        <Label Grid.Row="9"
               Content="Combustível:"/>

        <Label x:Name="lblCombustivel"
               Grid.Row="9"
               Grid.Column="1"
               Content="-"/>

    </Grid>
</Window>
